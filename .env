# RSVP backend: Google Apps Script web app that saves answers to the Google Sheet
# (request/response contract: docs/apps-script/Code.gs).
# Used by the published invitation. On localhost (dev server / preview) answers go
# to the local test backend /api/rsvp instead — never the real sheet — unless the
# page is opened with ?rsvpLive=1 (see src/game/mario/rsvp.js).
VITE_RSVP_ENDPOINT=https://script.google.com/macros/s/AKfycbyiRfRcvW2nQUzo6-YyOvvmyqUfbDtjXdet_3SU_WK6Y33efA7gUxYLOB_0SZX8eE9N/exec
